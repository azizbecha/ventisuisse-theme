{% comment %}
  VentiSuisse Story — image + text side-by-side block that reads images
  from theme assets via `asset_url` (same reason as vs-hero: lets us ship
  imagery without a manual Files upload).
{% endcomment %}

{%- liquid
  assign image_filename = section.settings.image_asset | default: 'vs-product-folding.jpg'
  assign image_url = image_filename | asset_url
-%}

<section
  class="vs-story color-{{ section.settings.color_scheme }} gradient vs-story--layout-{{ section.settings.layout }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="vs-story__grid">
      <div class="vs-story__media">
        <img
          src="{{ image_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          loading="lazy"
          width="1200"
          height="1200"
          class="vs-story__image"
        >
      </div>

      <div class="vs-story__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="vs-eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="vs-story__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="vs-story__body rte">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary vs-story__button">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .vs-story__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .vs-story__grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
    .vs-story--layout-image-right .vs-story__media {
      order: 2;
    }
  }
  .vs-story__media {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: rgba(var(--color-foreground), 0.04);
  }
  .vs-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .vs-story__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .vs-story__heading {
    margin: 0;
    line-height: 1.1;
  }
  .vs-story__body {
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .vs-story__button {
    align-self: flex-start;
    margin-top: 0.5rem;
  }
</style>

{% schema %}
{
  "name": "VentiSuisse Story",
  "tag": "section",
  "class": "section-vs-story",
  "settings": [
    {
      "type": "select",
      "id": "image_asset",
      "label": "Image",
      "options": [
        { "value": "vs-product-folding.jpg", "label": "Folding demonstration" },
        { "value": "vs-product-steel.jpg", "label": "304 stainless steel inner" },
        { "value": "vs-product-pink.jpg", "label": "Pink product (white bg)" },
        { "value": "vs-product-teal.jpg", "label": "Teal product (white bg)" },
        { "value": "vs-product-variants.jpg", "label": "4-color variant grid" },
        { "value": "vs-hero-corgi.jpg", "label": "Corgi drinking (lifestyle)" }
      ],
      "default": "vs-product-folding.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Close-up of the VentiSuisse flask with its silicone bowl panel flipped open"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "So funktioniert's"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Eine Bewegung — und der Napf ist da."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Das flexible Silikonpanel an der Seite klappt mit einem Daumendruck nach oben — Wasser rein, dein Hund trinkt. Wenn ihr fertig seid, klappst du es zurück, und die Flasche ist wieder auslaufsicher.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "VentiSuisse Story"
    }
  ]
}
{% endschema %}
