{% comment %}
  VentiSuisse Hero — full-bleed image hero that reads from theme assets
  via `asset_url` rather than the Files-backed `image_picker`. This lets
  us ship hero imagery as part of the theme push without requiring a
  manual Shopify Files upload step.

  Section settings let merchants:
  - Pick which bundled asset to use (default: vs-hero-corgi.jpg)
  - Override heading / subhead / two CTAs
  - Tune overlay opacity and content alignment
{% endcomment %}

{%- liquid
  assign background_type = section.settings.background_type | default: 'image'
  assign image_filename = section.settings.image_asset | default: 'vs-hero-corgi.jpg'
  assign image_url = image_filename | asset_url
  assign video_filename = section.settings.video_asset | default: 'vs-hero-video.mp4'
  assign video_url = video_filename | asset_url
  assign video_poster_filename = section.settings.video_poster_asset | default: 'vs-hero-video-poster.jpg'
  assign video_poster_url = video_poster_filename | asset_url
-%}

<section
  class="vs-hero color-{{ section.settings.color_scheme }} gradient"
  style="--vs-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="vs-hero__media">
    {%- if background_type == 'video' -%}
      <video
        class="vs-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="{{ video_poster_url }}"
        aria-hidden="true"
      >
        <source src="{{ video_url }}" type="video/mp4">
      </video>
    {%- else -%}
      <img
        class="vs-hero__image"
        src="{{ image_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="1067"
      >
    {%- endif -%}
  </div>

  <div class="vs-hero__content vs-hero__content--{{ section.settings.content_alignment }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="vs-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="vs-hero__heading h0">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subhead != blank -%}
      <p class="vs-hero__subhead">{{ section.settings.subhead | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="vs-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a href="{{ section.settings.button_link_1 | default: '#' }}" class="button button--primary">
            {{ section.settings.button_label_1 | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="button button--secondary">
            {{ section.settings.button_label_2 | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .vs-hero {
    position: relative;
    width: 100%;
    min-height: 78vh;
    overflow: hidden;
    display: grid;
  }
  .vs-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .vs-hero__image,
  .vs-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .vs-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, calc(var(--vs-hero-overlay) * 0.4)) 0%,
      rgba(0, 0, 0, var(--vs-hero-overlay)) 100%
    );
    pointer-events: none;
  }
  .vs-hero__content {
    position: relative;
    z-index: 1;
    color: #fff;
    padding: 8vw 6vw;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-self: end;
  }
  .vs-hero__content--center {
    align-self: center;
    justify-self: center;
    text-align: center;
    max-width: 800px;
  }
  .vs-hero__content--top-left {
    align-self: start;
  }
  .vs-hero__content--bottom-right {
    align-self: end;
    justify-self: end;
    text-align: right;
  }
  .vs-hero .vs-eyebrow {
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 0;
  }
  .vs-hero__heading {
    margin: 0;
    line-height: 1.05;
    color: inherit;
  }
  .vs-hero__subhead {
    margin: 0;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    max-width: 56ch;
    line-height: 1.4;
    opacity: 0.9;
  }
  .vs-hero__buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .vs-hero .button--secondary {
    background: transparent;
    color: #fff;
    border: 1.5px solid #fff;
  }
  .vs-hero .button--secondary:hover {
    background: #fff;
    color: rgb(var(--color-foreground));
  }
  @media screen and (max-width: 749px) {
    .vs-hero {
      min-height: 84vh;
    }
    .vs-hero__content {
      padding: 10vw 6vw;
    }
  }
</style>

{% schema %}
{
  "name": "VentiSuisse Hero",
  "tag": "section",
  "class": "section-vs-hero",
  "settings": [
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { "value": "video", "label": "Video (autoplay, muted, loop)" },
        { "value": "image", "label": "Image" }
      ],
      "default": "video"
    },
    {
      "type": "select",
      "id": "video_asset",
      "label": "Background video",
      "info": "Used when 'Background type' is set to Video.",
      "options": [
        { "value": "vs-hero-video.mp4", "label": "Product video (editorial, ~16s)" }
      ],
      "default": "vs-hero-video.mp4"
    },
    {
      "type": "select",
      "id": "video_poster_asset",
      "label": "Video poster image",
      "info": "Shown while the video loads.",
      "options": [
        { "value": "vs-hero-video-poster.jpg", "label": "Auto-generated frame" },
        { "value": "vs-hero-corgi.jpg", "label": "Corgi drinking" },
        { "value": "vs-product-variants.jpg", "label": "4-variant grid" }
      ],
      "default": "vs-hero-video-poster.jpg"
    },
    {
      "type": "select",
      "id": "image_asset",
      "label": "Background image",
      "info": "Used when 'Background type' is set to Image.",
      "options": [
        { "value": "vs-hero-corgi.jpg", "label": "Corgi drinking (lifestyle)" },
        { "value": "vs-product-teal.jpg", "label": "Teal product (white bg)" },
        { "value": "vs-product-pink.jpg", "label": "Pink product (white bg)" },
        { "value": "vs-product-variants.jpg", "label": "4-color variant grid" },
        { "value": "vs-product-folding.jpg", "label": "Folding demonstration" }
      ],
      "default": "vs-hero-corgi.jpg"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "A corgi drinks from the VentiSuisse trail-flask's flip-out silicone bowl"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Schweizer trail-hydration"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Eine Flasche. Ein Napf. Endlose Wege."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Auslaufsicher, isoliert, 285 ml. Mit einem ausklappbaren Silikonnapf, damit dein Hund unterwegs trinken kann — wo auch immer der Weg hinführt."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button text",
      "default": "Jetzt kaufen"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button text",
      "default": "So funktioniert's"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center", "label": "Center" },
        { "value": "top-left", "label": "Top left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "VentiSuisse Hero"
    }
  ]
}
{% endschema %}
