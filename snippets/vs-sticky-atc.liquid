{% comment %}
  VentiSuisse mobile-only sticky Add-to-Cart bar.

  Renders a fixed bar at the bottom of the viewport (mobile <750px only,
  controlled by CSS in base.css). It observes the real ATC button via
  IntersectionObserver and reveals itself when the real button is off-screen.
  Clicking the sticky button programmatically clicks the real ATC button so
  Dawn's product-form logic (cart notification, error handling, variant
  validation) all fires correctly.

  Accepts:
  - product:    {Object} the current product
  - section_id: {String} parent section id (used to find ProductSubmitButton-{section_id})

  Usage:
    {% render 'vs-sticky-atc', product: product, section_id: section.id %}
{% endcomment %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign image = variant.featured_image | default: product.featured_image
-%}

<vs-sticky-atc
  class="vs-sticky-atc"
  data-target-id="ProductSubmitButton-{{ section_id }}"
  aria-hidden="true"
>
  <div class="vs-sticky-atc__inner">
    {%- if image -%}
      <img
        class="vs-sticky-atc__thumb"
        src="{{ image | image_url: width: 80 }}"
        alt=""
        width="40"
        height="40"
        loading="lazy"
      >
    {%- endif -%}

    <div class="vs-sticky-atc__meta">
      <span class="vs-sticky-atc__title">{{ product.title | escape }}</span>
      <span class="vs-sticky-atc__price" data-price>{{ variant.price | money }}</span>
    </div>

    <button
      type="button"
      class="vs-sticky-atc__button button button--primary"
      data-vs-sticky-trigger
    >
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
</vs-sticky-atc>

<style>
  .vs-sticky-atc__thumb {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .vs-sticky-atc__meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .vs-sticky-atc__title {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vs-sticky-atc__price {
    font-size: 0.8rem;
    opacity: 0.7;
  }
  .vs-sticky-atc__button {
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    min-width: 110px;
  }
</style>

<script>
  if (!customElements.get('vs-sticky-atc')) {
    customElements.define(
      'vs-sticky-atc',
      class extends HTMLElement {
        connectedCallback() {
          this.target =
            (this.dataset.targetId && document.getElementById(this.dataset.targetId)) ||
            document.querySelector('.product-form__submit') ||
            document.querySelector('button[name="add"]');
          this.trigger = this.querySelector('[data-vs-sticky-trigger]');

          if (!this.target) return;

          this.observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  this.classList.remove('is-visible');
                  this.setAttribute('aria-hidden', 'true');
                } else {
                  this.classList.add('is-visible');
                  this.setAttribute('aria-hidden', 'false');
                }
              });
            },
            { rootMargin: '0px 0px -10% 0px', threshold: 0 }
          );

          this.observer.observe(this.target);

          if (this.trigger) {
            this.trigger.addEventListener('click', () => {
              if (this.target && !this.target.disabled) this.target.click();
            });
          }

          this.priceSubscription = this.subscribeToVariantChange();
        }

        subscribeToVariantChange() {
          const priceEl = this.querySelector('[data-price]');
          if (!priceEl) return;

          const variantSelect = document.querySelector('variant-selects');
          if (!variantSelect) return;

          const observer = new MutationObserver(() => {
            const dataEl = variantSelect.querySelector('[data-selected-variant]');
            if (!dataEl) return;
            try {
              const variant = JSON.parse(dataEl.textContent);
              if (variant && variant.price !== undefined) {
                priceEl.textContent = (variant.price / 100).toLocaleString('de-CH', {
                  style: 'currency',
                  currency: window.Shopify?.currency?.active || 'CHF',
                });
              }
            } catch (e) {
              /* ignore */
            }
          });

          observer.observe(variantSelect, { childList: true, subtree: true, characterData: true });
          return observer;
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
          if (this.priceSubscription) this.priceSubscription.disconnect();
        }
      }
    );
  }
</script>
